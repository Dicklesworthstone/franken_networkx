{
  "schema_version": "1.0.0",
  "thresholds_id": "perf-slo-thresholds-v1",
  "spec_reference": "COMPREHENSIVE_SPEC_FOR_FRANKENNETWORKX_V1.md section 17",
  "description": "Machine-readable SLO thresholds and representative workloads for the FrankenNetworkX performance gate.",
  "workloads": [
    {
      "metric_id": "shortest_path",
      "family": "shortest_path",
      "route": "RUST_NATIVE",
      "representative_shape": "unweighted source-target 250x250 grid graph (62,500 nodes, 124,500 edges)",
      "primary_metric": "path_nodes",
      "primary_unit": "path_nodes",
      "runs": 5,
      "warmup_runs": 1,
      "max_p95_ms": 420.0,
      "params": {
        "width": 250,
        "height": 250
      }
    },
    {
      "metric_id": "shortest_path_weighted_delegated",
      "family": "shortest_path",
      "route": "NETWORKX_HELPER",
      "representative_shape": "sparse weighted graph with non-unit `weight` edge attributes (25,000 nodes, 49,987 weighted edges)",
      "primary_metric": "path_nodes",
      "primary_unit": "path_nodes",
      "runs": 3,
      "warmup_runs": 1,
      "max_p95_ms": 420.0,
      "params": {
        "nodes": 25000,
        "nonunit_weight": 2.0,
        "chord_strides": [7, 19]
      }
    },
    {
      "metric_id": "components",
      "family": "components",
      "representative_shape": "million-edge multi-component ring-lattice corpus (100,000 nodes, 1,000,000 edges, 20 components)",
      "primary_metric": "component_count",
      "primary_unit": "component_count",
      "runs": 5,
      "warmup_runs": 1,
      "max_p95_ms": 280.0,
      "params": {
        "component_count": 20,
        "component_size": 5000,
        "k": 20,
        "shards": 4
      }
    },
    {
      "metric_id": "centrality",
      "family": "centrality",
      "representative_shape": "medium-large small-world graph PageRank (50,000 nodes, 100,000 edges)",
      "primary_metric": "score",
      "primary_unit": "score",
      "runs": 5,
      "warmup_runs": 1,
      "max_p95_ms": 950.0,
      "params": {
        "nodes": 50000,
        "k": 4,
        "edge_prob": 0.1,
        "seed": 1337
      }
    },
    {
      "metric_id": "flow",
      "family": "flow",
      "representative_shape": "multi-seed layered flow corpus (3 topologies: 12x12, 16x10, 20x8)",
      "primary_metric": "flow_value",
      "primary_unit": "flow_value",
      "runs": 5,
      "warmup_runs": 1,
      "max_p95_ms": 700.0,
      "params": {
        "layers": 12,
        "width": 12,
        "topologies": [
          {"layers": 12, "width": 12, "seed": 1},
          {"layers": 16, "width": 10, "seed": 2},
          {"layers": 20, "width": 8, "seed": 3}
        ]
      }
    },
    {
      "metric_id": "io_roundtrip",
      "family": "io",
      "representative_shape": "medium-large edgelist write+read roundtrip (12,000 nodes, 60,000 edges, 2 rounds)",
      "primary_metric": "mb_per_s",
      "primary_unit": "mb_per_s",
      "runs": 5,
      "warmup_runs": 1,
      "min_primary_value": 45.0,
      "params": {
        "nodes": 12000,
        "k": 10,
        "edge_prob": 0.05,
        "seed": 1337,
        "rounds": 2
      }
    },
    {
      "metric_id": "mutation_cycle",
      "family": "mutation",
      "representative_shape": "add_node / add_edge / remove_edge / incident-edge remove_node cycle (5,000 nodes, 44,993 ops)",
      "primary_metric": "ops_per_s",
      "primary_unit": "ops_per_s",
      "runs": 5,
      "warmup_runs": 1,
      "params": {
        "node_count": 5000,
        "edge_repeat": 3
      }
    }
  ],
  "derived_checks": [
    {
      "metric_id": "mutation_regression",
      "baseline_ops_per_second": 125000.0,
      "max_regression_pct": 8.0,
      "rationale": "Base target for release-mode O(1) mutations per SPEC §17"
    },
    {
      "metric_id": "memory_regression",
      "baseline_max_rss_kb": 180000.0,
      "max_regression_pct": 10.0,
      "rationale": "Tightened memory bound for core graph structures"
    },
    {
      "metric_id": "p99_tail_regression",
      "baseline_max_latency_p99_ms": 550.0,
      "max_regression_pct": 10.0,
      "rationale": "Aligned with p95 targets + 30% tail margin"
    }
  ]
}
